+  // permanently, which is exactly the failure this function is meant to prevent.
+  if (process.platform === "win32") {
+    const killed = await killWindowsProfileOwners(profileDir);
+    await rm(join(profileDir, "lockfile"), { force: true });
+    return killed > 0;
+  }
+
